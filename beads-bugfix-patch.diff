diff --git a/internal/storage/dolt/versioned.go b/internal/storage/dolt/versioned.go
--- a/internal/storage/dolt/versioned.go
+++ b/internal/storage/dolt/versioned.go
@@ -37,6 +37,28 @@ BUG-5 FIX PART 2: Resolve HEAD~N notation to actual commit hash before querying
 // Diff returns changes between two commits/branches.
 func (s *DoltStore) Diff(ctx context.Context, fromRef, toRef string) ([]*storage.DiffEntry, error) {
+	// BUG-5 FIX: Resolve HEAD~N notation to actual commit hash
+	// Dolt doesn't understand git-style tilde notation natively
+	fromRef = s.resolveTildeRef(ctx, fromRef)
+	toRef = s.resolveTildeRef(ctx, toRef)
+
 	// Validate refs to prevent SQL injection
 	if err := validateRef(fromRef); err != nil {
@@ -95,3 +117,32 @@ func (s *DoltStore) Diff(...) ... {
 	return entries, nil
 }
+
+// resolveTildeRef resolves HEAD~N notation to an actual commit hash by walking
+// the dolt_log table. Dolt doesn't support git-style tilde notation natively.
+func (s *DoltStore) resolveTildeRef(ctx context.Context, ref string) string {
+	if !strings.Contains(ref, "~") {
+		return ref
+	}
+	parts := strings.SplitN(ref, "~", 2)
+	if len(parts) != 2 {
+		return ref
+	}
+	baseRef := parts[0]
+	n, err := strconv.Atoi(parts[1])
+	if err != nil || n < 1 {
+		return ref
+	}
+
+	// Query dolt_log to walk back N commits from baseRef
+	query := `SELECT commit_hash FROM dolt_log WHERE commit_hash != '' ORDER BY date DESC`
+	if baseRef == "HEAD" {
+		query += ` LIMIT ?`
+		rows, err := s.db.QueryContext(ctx, query, n+1)
+		if err != nil {
+			return ref
+		}
+		defer rows.Close()
+		for i := 0; rows.Next(); i++ {
+			var hash string
+			if err := rows.Scan(&hash); err != nil {
+				break
+			}
+			if i == n {
+				return hash
+			}
+		}
+	}
+	return ref
+}


